# YouTube Data API v3
# Create a project at https://console.cloud.google.com, enable YouTube Data API v3, create an API key
YOUTUBE_API_KEY=

# Your YouTube channel ID (found in channel URL or https://www.youtube.com/account_advanced)
YOUTUBE_CHANNEL_ID=

# Resend API key for contact form emails (https://resend.com)
# REQUIRED IN PRODUCTION. Unset in dev, the contact form logs to the console and
# reports success; unset in production it returns 503 and tells the sender to use
# LinkedIn instead, rather than silently dropping the message.
RESEND_API_KEY=

# Optional. Sender address for contact-form mail. Defaults to Resend's shared
# sandbox (onboarding@resend.dev), which has poor deliverability and can only send
# to your own account address — set this to an address on a domain you have
# verified in Resend.
CONTACT_FROM=

# Optional. Where contact-form mail is delivered. Defaults to rodgers.momanyi@outlook.com
CONTACT_TO=
